    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  // Deep copy the item to bypass n8n's read-only/frozen object restriction\n  const newItem = JSON.parse(JSON.stringify(item));\n  \n  newItem.json.messageText = newItem.json.message && newItem.json.message.text ? newItem.json.message.text : '';\n  \n  // Check for web_app_data property inquiries\n  if (newItem.json.message && newItem.json.message.web_app_data && newItem.json.message.web_app_data.data) {\n    try {\n      const webAppData = JSON.parse(newItem.json.message.web_app_data.data);\n      newItem.json.webAppData = webAppData;\n      if (webAppData.action === 'property_inquiry') {\n        newItem.json.messageText = '__web_app_property_inquiry__';\n      }\n    } catch (e) {\n      console.error(\"Failed to parse web_app_data:\", e.message);\n    }\n  }\n  \n  // Safeguard basic properties for downstream nodes\n  if (!newItem.json.message) {\n    newItem.json.message = {\n      chat: { id: 7431843172 },\n      from: { first_name: 'Клієнт' }\n    };\n  } else {\n    if (!newItem.json.message.chat) {\n      newItem.json.message.chat = { id: 7431843172 };\n    }\n    if (!newItem.json.message.from) {\n      newItem.json.message.from = { first_name: 'Клієнт' };\n    }\n  }\n  \n  return newItem;\n});"
      },
